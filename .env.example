# Copy this file to .env and replace the example passwords and secret.
DB_PASSWORD=change_this_database_password
JWT_SECRET=replace_this_with_a_random_string_of_at_least_32_characters
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
ACCESS_MINUTES=15
REFRESH_DAYS=7
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5500
API_PORT=8000
DB_HOST_PORT=5433
SWAGGER_PORT=8081
FRONTEND_INTERNAL_PORT=80
API_INTERNAL_PORT=8080
DB_INTERNAL_PORT=5432
SWAGGER_INTERNAL_PORT=8080
DB_IMAGE=postgres:16-alpine
SWAGGER_IMAGE=docker.swagger.io/swaggerapi/swagger-ui:v5.21.0
API_BUILD_CONTEXT=./java-backend
FRONTEND_BUILD_CONTEXT=./angular-frontend
SWAGGER_SPEC_SOURCE=./java-backend/src/main/webapp/openapi.yaml
SWAGGER_SPEC_TARGET=/openapi.yaml
DB_VOLUME_NAME=lab-2_postgres_data
DB_DATA_PATH=/var/lib/postgresql/data
DB_NAME=students_lab3
DB_USER=lab3
DB_URL=jdbc:postgresql://db:5432/students_lab3
APP_TIMEZONE=Europe/Moscow
API_HEALTH_URL=http://localhost:8080/openapi.yaml
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8081,http://127.0.0.1:8081
